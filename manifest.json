{
  "manifest_version": 3,
  "name": "Form Auto-Fill",
  "version": "2.0",
  "description": "Save your data once, auto-fill forms instantly",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Form Auto-Fill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}